import React, { useEffect, useMemo, useState } from 'react';
import { createRoot } from 'react-dom/client';
import './style.css';
type Field = { id: string; label: string; section: string; type: string; options?: {code:string;label:string}[] };
type Catalog = { sections:{id:string;label:string}[]; fields:Field[] };
type Evidence = {quote:string;start:number;end:number};
type FieldValue = {status:'extracted'|'unknown'|'conflict';value?:unknown;confidence?:'high'|'medium'|'low';provenance?:Evidence[];note?:string};
type Case = {case_index:number;label?:string;fields:Record<string,FieldValue>};
type Doc = {
  id: string;
  text: string;
  extraction: null | {
    cases: Case[];
    flags?: string[];
  };
};

type CaseApiResponse = {
  documentId: string;
  sourceText: string;
  extraction: Doc['extraction'];
};
type Summary = {id:string;title:string;caseCount:number;flags:string[]};
const base='http://localhost:8082';
function showValue(v:unknown):string {return Array.isArray(v)?v.join(', '):v==null?'—':String(v)}
function App(){
 const [catalog,setCatalog]=useState<Catalog|null>(null),[docs,setDocs]=useState<Summary[]>([]),[selected,setSelected]=useState('D01');
 const [doc,setDoc]=useState<Doc|null>(null),[caseIndex,setCaseIndex]=useState(0),[fieldId,setFieldId]=useState<string|null>(null),[error,setError]=useState('');
 useEffect(()=>{Promise.all([fetch(base+'/api/catalog').then(r=>r.json()),fetch(base+'/api/documents').then(r=>r.json())]).then(([c,d])=>{setCatalog(c);setDocs(d)}).catch(()=>setError('Cannot reach backend. Start Spring Boot on port 8080.'))},[]);
 useEffect(() => {
  let cancelled = false;

  setDoc(null);
  setCaseIndex(0);
  setFieldId(null);
  setError('');

  fetch(base + '/api/cases/' + selected)
    .then(async response => {
      if (!response.ok) {
        throw new Error(
          `Unable to load ${selected}: HTTP ${response.status}`
        );
      }

      return response.json() as Promise<CaseApiResponse>;
    })
    .then(data => {
      if (cancelled) return;

      setDoc({
        id: data.documentId,
        text: data.sourceText,
        extraction: data.extraction
      });
    })
    .catch(error => {
      if (!cancelled) {
        setError(error.message);
      }
    });

  return () => {
    cancelled = true;
  };
}, [selected]);
 const current=doc?.extraction?.cases[caseIndex];
 const active=fieldId&&current?current.fields[fieldId]:null;
 const spans=useMemo(()=>{if(!doc||!active?.provenance?.length)return null;const ev=active.provenance[0];if(ev.start<0||ev.end>Array.from(doc.text).length||ev.start>=ev.end)return null;const chars=Array.from(doc.text);return [chars.slice(0,ev.start).join(''),chars.slice(ev.start,ev.end).join(''),chars.slice(ev.end).join('')]},[doc,active]);
 useEffect(()=>{document.querySelector('mark')?.scrollIntoView({block:'center',behavior:'smooth'})},[spans]);
 return <div className="app"><aside className="sidebar"><div className="brand"><span className="brand-icon">✳</span><div>CASE INTAKE<small>REVIEW WORKSPACE</small></div></div><div className="nav-heading">DOCUMENT QUEUE <span>{docs.length}</span></div><div className="doc-list">{docs.map(d=><button key={d.id} className={'doc-link '+(selected===d.id?'chosen':'')} onClick={()=>setSelected(d.id)}><span className="doc-id">{d.id}</span><span className="doc-title">{d.title}</span><span className="case-count">{d.caseCount}</span></button>)}</div><div className="side-footer">Offline-ready · Catalog-driven</div></aside>
 <main><header className="topbar"><div><div className="eyebrow">DOCUMENT REVIEW / {selected}</div><h1>Evidence review</h1><p>Verify extracted fields against the original source text.</p></div><div className="top-pill">● {doc?.extraction?'Extraction available':'Awaiting extraction'}</div></header>
 {error&&<div className="error" role="alert">{error}</div>}
 {!doc?<div className="placeholder">Loading document…</div>:<div className="workspace"><section className="panel document-panel"><div className="panel-head"><div><span className="eyebrow">SOURCE DOCUMENT</span><h2>{selected} · Original report</h2></div><span className="meta">{Array.from(doc.text).length} characters</span></div><div className="document-text">{spans?<>{spans[0]}<mark>{spans[1]}</mark>{spans[2]}</>:doc.text}</div></section>
 <section className="panel fields-panel"><div className="panel-head"><div><span className="eyebrow">STRUCTURED EXTRACTION</span><h2>Extracted values</h2></div><span className="meta">{catalog?.fields.length||0} fields</span></div>
 {!doc.extraction?<div className="empty"><h3>No extraction yet</h3><p>Generate genuine model fixtures and run replay to populate this document.</p></div>:!doc.extraction.cases.length?<div className="empty"><h3>No valid cases</h3><p>{doc.extraction.flags?.join(', ')||'No case identified in this document.'}</p></div>:<><div className="case-tabs">{doc.extraction.cases.map((c,i)=><button className={caseIndex===i?'active':''} key={i} onClick={()=>{setCaseIndex(i);setFieldId(null)}}>{c.label||'Case '+(i+1)}</button>)}</div><div className="field-scroll">{catalog?.sections.map(section=><div key={section.id} className="field-section"><h3>{section.label}</h3>{catalog.fields.filter(f=>f.section===section.id).map(f=>{const v=current?.fields[f.id];return <button key={f.id} className={'field-row '+(fieldId===f.id?'selected':'')} onClick={()=>setFieldId(f.id)}><span className="field-main"><span className="field-label">{f.label}</span><strong>{v?.status==='extracted'?showValue(v.value):v?.status||'not provided'}</strong>{fieldId===f.id&&v?.provenance?.length?<small className="evidence">“{v.provenance[0].quote}”</small>:null}</span><span className={'badge '+(v?.confidence||v?.status||'unknown')}>{v?.confidence||v?.status||'unknown'}</span></button>})}</div>)}</div></>}
 </section></div>}
 </main></div>
}
createRoot(document.getElementById('root')!).render(<React.StrictMode><App/></React.StrictMode>);
